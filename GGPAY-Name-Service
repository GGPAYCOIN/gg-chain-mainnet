pragma solidity ^0.8.0;

contract GGPAYNameservice {
    mapping(string => address) public domains;
    uint256 public registrationPrice = 1 ether; // 1 GG Coin

    event NameRegistered(string name, address owner);

    function registerName(string memory _name) public payable {
        require(msg.value >= registrationPrice, "Insufficient GG sent");
        require(domains[_name] == address(0), "Domain already taken");

        domains[_name] = msg.sender;
        emit NameRegistered(_name, msg.sender);
    }
}

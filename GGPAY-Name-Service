pragma solidity ^0.8.0;

contract GGPAYNameservice {
    string public suffix = ".ggpay";
    uint256 public fee = 1 ether; // 1 GG
    address public admin;

    mapping(string => address) public domains;

    constructor() {
        admin = msg.sender;
    }

    function register(string memory _name) public payable {
        require(msg.value >= fee, "Please send 1 GG to register");
        require(domains[_name] == address(0), "This name is already registered");
        domains[_name] = msg.sender;
    }
}
